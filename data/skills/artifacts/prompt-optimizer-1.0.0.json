{
  "schemaVersion": "agent-skill-artifact.v1",
  "artifactRef": "builtin://sdkwork.skills.prompt_optimizer@1.0.0",
  "version": "1.0.0",
  "runtime": "builtin",
  "entrypoint": "sdkwork.skills.prompt_optimizer",
  "checksumHash": "sha256:3dae84ec4a2bbff9c17a65db78aded0974cbcac33007decee51bff6f779bfc0f",
  "skill": {
    "id": 8101,
    "skillKey": "prompt-optimizer",
    "name": "Prompt Optimizer"
  },
  "instructions": [
    "Inspect the provided prompt for ambiguous objectives, missing constraints, conflicting instructions, and weak output contracts.",
    "Rewrite the prompt with explicit role, task, inputs, constraints, output format, and verification criteria.",
    "Return a concise risk report and the hardened prompt without inventing unsupported requirements."
  ],
  "inputSchema": {
    "type": "object",
    "required": ["prompt"],
    "properties": {
      "prompt": { "type": "string", "minLength": 1 },
      "targetModel": { "type": "string" },
      "strictness": { "type": "string", "enum": ["balanced", "strict", "maximum"] }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "required": ["optimizedPrompt", "findings"],
    "properties": {
      "optimizedPrompt": { "type": "string" },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["severity", "message"],
          "properties": {
            "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "limits": {
    "maxInputBytes": 32768,
    "maxOutputBytes": 65536
  }
}
