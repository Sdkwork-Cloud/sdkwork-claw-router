{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": "../..",
    "paths": {
      "@sdkwork/clawrouter-backend-sdk": [
        "../../sdks/clawrouter-backend-sdk/clawrouter-backend-sdk-typescript/generated/server-openapi/src/index.ts"
      ],
      "sdkwork-clawrouter-pc-commons": [
        "./packages/sdkwork-clawrouter-pc-commons/src/index.ts"
      ],
      "sdkwork-clawrouter-pc-commons/runtime": [
        "./packages/sdkwork-clawrouter-pc-commons/src/runtime.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src"
  ]
}
