{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": "../..",
    "paths": {
      "@sdkwork/clawrouter-app-sdk": [
        "../../sdks/clawrouter-app-sdk/clawrouter-app-sdk-typescript/generated/server-openapi/src/index.ts"
      ],
      "@sdkwork/clawrouter-backend-sdk": [
        "../../sdks/clawrouter-backend-sdk/clawrouter-backend-sdk-typescript/generated/server-openapi/src/index.ts"
      ],
      "@sdkwork/clawrouter-open-sdk": [
        "../../sdks/clawrouter-open-sdk/clawrouter-open-sdk-typescript/generated/server-openapi/src/index.ts"
      ],
      "@sdkwork/clawrouter-pc-commons/components/BusinessState": [
        "./packages/sdkwork-clawrouter-pc-commons/src/components/BusinessState.tsx"
      ],
      "@sdkwork/clawrouter-pc-commons/api-result": [
        "./packages/sdkwork-clawrouter-pc-commons/src/api-result.ts"
      ],
      "@sdkwork/clawrouter-pc-commons/sdk-clients": [
        "./packages/sdkwork-clawrouter-pc-commons/src/sdk-clients.ts"
      ],
      "@sdkwork/clawrouter-pc-commons/sdk-request-boundary": [
        "./packages/sdkwork-clawrouter-pc-commons/src/sdk-request-boundary.ts"
      ],
      "@sdkwork/iam-runtime": [
        "./src/typecheck-shims.d.ts"
      ],
      "@sdkwork/iam-service": [
        "./src/typecheck-shims.d.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src"
  ]
}
