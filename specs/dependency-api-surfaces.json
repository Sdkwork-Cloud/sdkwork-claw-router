{
  "schemaVersion": 1,
  "kind": "sdkwork.dependency-api-surfaces",
  "application": "sdkwork-claw-router",
  "description": "Runtime dependency API surface declarations for dependency SDKs consumed by SDKWork Claw Router. sdkDependencies owns generation boundaries; this manifest owns runtime mount/base-url decisions.",
  "gatewayIntegration": {
    "targetApplication": "sdkwork-api-gateway",
    "targetMode": "shared-gateway",
    "commonSdkRootEnv": "PORTAL_PUBLIC_SDK_BASE_URL",
    "authority": "cargo-workspace",
    "catalogPolicy": "no-dedicated-gateway-catalog",
    "productApiPolicy": "sdkwork-claw-router APIs remain product-owned SDKWork API surfaces",
    "migrationState": "shared-gateway-default"
  },
  "dependencies": [
    {
      "workspace": "sdkwork-appbase-app-sdk",
      "consumerSdkFamily": "clawrouter-app-sdk",
      "role": "appbase-app-capability",
      "dependencyMode": "consumer-sdk",
      "surface": "app-api",
      "apiPrefix": "/app/v3/api",
      "runtimeIntegration": {
        "mode": "external-service",
        "sameOriginAllowed": false,
        "targetRuntimeIntegration": {
          "mode": "shared-gateway",
          "gatewayApplication": "sdkwork-api-gateway",
          "commonSdkRootEnv": "PORTAL_PUBLIC_SDK_BASE_URL",
          "catalogPolicy": "no-dedicated-gateway-catalog"
        },
        "requiredBaseUrlEnv": "VITE_SDKWORK_APPBASE_APP_API_BASE_URL",
        "commonBaseUrlEnv": "PORTAL_PUBLIC_SDK_BASE_URL",
        "mountCoverage": {
          "status": "not-mounted",
          "evidence": [
            "Default Claw Router app runtime treats appbase app API as a dependency surface served by sdkwork-api-gateway through PORTAL_PUBLIC_SDK_BASE_URL.",
            "services/sdkwork-claw-app/tests/contract_routes.rs verifies the default app router does not locally mount appbase IAM app routes."
          ]
        }
      }
    },
    {
      "workspace": "sdkwork-commerce-app-sdk",
      "consumerSdkFamily": "clawrouter-app-sdk",
      "role": "commerce-app-capability",
      "dependencyMode": "consumer-sdk",
      "surface": "app-api",
      "apiPrefix": "/app/v3/api",
      "runtimeIntegration": {
        "mode": "external-service",
        "sameOriginAllowed": false,
        "targetRuntimeIntegration": {
          "mode": "shared-gateway",
          "gatewayApplication": "sdkwork-api-gateway",
          "commonSdkRootEnv": "PORTAL_PUBLIC_SDK_BASE_URL",
          "catalogPolicy": "no-dedicated-gateway-catalog"
        },
        "requiredBaseUrlEnv": "VITE_SDKWORK_COMMERCE_APP_API_BASE_URL",
        "publicBaseUrlEnv": "PORTAL_PUBLIC_COMMERCE_APP_API_BASE_URL",
        "commonBaseUrlEnv": "PORTAL_PUBLIC_SDK_BASE_URL",
        "mountCoverage": {
          "status": "not-mounted",
          "evidence": [
            "Commerce app API routes are owned by sdkwork-commerce and consumed through sdkwork-commerce-app-sdk.",
            "Claw Router portal bootstrap derives VITE_SDKWORK_COMMERCE_APP_API_BASE_URL from PORTAL_PUBLIC_SDK_BASE_URL + /app/v3/api when no Commerce-specific override is configured.",
            "Claw Router app runtime uses product-local contract fallback filtering so Commerce dependency app routes return 404 by default instead of local 501 contract stubs.",
            "cargo test -p sdkwork-claw-app --test contract_routes default_router_does_not_mount_commerce_foundation_routes_locally verifies default app runtime does not locally serve Commerce foundation routes.",
            "No Claw Router runtime mount coverage is declared for Commerce app API handlers."
          ]
        }
      }
    },
    {
      "workspace": "sdkwork-appbase-backend-sdk",
      "consumerSdkFamily": "clawrouter-backend-sdk",
      "role": "appbase-backend-management-capability",
      "dependencyMode": "consumer-sdk",
      "surface": "backend-api",
      "apiPrefix": "/backend/v3/api",
      "dependencyOwnedOperations": [
        {
          "method": "GET",
          "path": "/backend/v3/api/iam/api_keys",
          "operationId": "apiKeys.list",
          "owner": "sdkwork-appbase",
          "sdkClient": "getSdkworkAppbaseBackendSdkClient().iam.apiKeys.list",
          "consumerRequired": true
        },
        {
          "method": "POST",
          "path": "/backend/v3/api/iam/api_keys/{apiKeyId}/revoke",
          "operationId": "apiKeys.revoke",
          "owner": "sdkwork-appbase",
          "sdkClient": "getSdkworkAppbaseBackendSdkClient().iam.apiKeys.revoke",
          "consumerRequired": false
        },
        {
          "method": "GET",
          "path": "/backend/v3/api/iam/users",
          "operationId": "users.list",
          "owner": "sdkwork-appbase",
          "sdkClient": "getSdkworkAppbaseBackendSdkClient().iam.users.list",
          "consumerRequired": true
        },
        {
          "method": "POST",
          "path": "/backend/v3/api/iam/users",
          "operationId": "users.create",
          "owner": "sdkwork-appbase",
          "sdkClient": "getSdkworkAppbaseBackendSdkClient().iam.users.create",
          "consumerRequired": true
        },
        {
          "method": "PATCH",
          "path": "/backend/v3/api/iam/users/{userId}",
          "operationId": "users.update",
          "owner": "sdkwork-appbase",
          "sdkClient": "getSdkworkAppbaseBackendSdkClient().iam.users.update",
          "consumerRequired": true
        }
      ],
      "productOwnedOperationOverrides": [
        {
          "method": "POST",
          "path": "/backend/v3/api/iam/api_keys",
          "operationId": "apiKeys.create",
          "owner": "sdkwork-claw-router",
          "sdkClient": "getClawRouterBackendSdkClient().iam.apiKeys.create",
          "consumerRequired": true,
          "evidence": "services/sdkwork-claw-product/src/api/admin_user.rs create_api_key builds Claw Router gateway API key secrets, hashes, audit records, and idempotency."
        },
        {
          "method": "DELETE",
          "path": "/backend/v3/api/iam/api_keys/{apiKeyId}",
          "operationId": "apiKeys.delete",
          "owner": "sdkwork-claw-router",
          "sdkClient": "getClawRouterBackendSdkClient().iam.apiKeys.delete",
          "consumerRequired": true,
          "evidence": "services/sdkwork-claw-product/src/api/admin_user.rs delete_api_key deletes Claw Router gateway API keys through the product AdminUserStore."
        }
      ],
      "runtimeIntegration": {
        "mode": "external-service",
        "sameOriginAllowed": false,
        "targetRuntimeIntegration": {
          "mode": "shared-gateway",
          "gatewayApplication": "sdkwork-api-gateway",
          "commonSdkRootEnv": "PORTAL_PUBLIC_SDK_BASE_URL",
          "catalogPolicy": "no-dedicated-gateway-catalog"
        },
        "requiredBaseUrlEnv": "VITE_SDKWORK_APPBASE_BACKEND_API_BASE_URL",
        "commonBaseUrlEnv": "PORTAL_PUBLIC_SDK_BASE_URL",
        "mountCoverage": {
          "status": "not-mounted",
          "evidence": [
            "Default Claw Router backend runtime treats appbase backend IAM API as a dependency surface served by sdkwork-api-gateway through PORTAL_PUBLIC_SDK_BASE_URL.",
            "services/sdkwork-claw-admin/tests/contract_routes.rs verifies the default admin router does not locally mount appbase backend IAM routes."
          ]
        }
      }
    },
    {
      "workspace": "sdkwork-commerce-backend-sdk",
      "consumerSdkFamily": "clawrouter-backend-sdk",
      "role": "commerce-backend-management-capability",
      "dependencyMode": "consumer-sdk",
      "surface": "backend-api",
      "apiPrefix": "/backend/v3/api",
      "runtimeIntegration": {
        "mode": "external-service",
        "sameOriginAllowed": false,
        "targetRuntimeIntegration": {
          "mode": "shared-gateway",
          "gatewayApplication": "sdkwork-api-gateway",
          "commonSdkRootEnv": "PORTAL_PUBLIC_SDK_BASE_URL",
          "catalogPolicy": "no-dedicated-gateway-catalog"
        },
        "requiredBaseUrlEnv": "VITE_SDKWORK_COMMERCE_BACKEND_API_BASE_URL",
        "publicBaseUrlEnv": "PORTAL_PUBLIC_COMMERCE_BACKEND_API_BASE_URL",
        "commonBaseUrlEnv": "PORTAL_PUBLIC_SDK_BASE_URL",
        "mountCoverage": {
          "status": "not-mounted",
          "evidence": [
            "Commerce backend API routes are owned by sdkwork-commerce and consumed through sdkwork-commerce-backend-sdk plus @sdkwork/commerce-service.",
            "Claw Router portal bootstrap derives VITE_SDKWORK_COMMERCE_BACKEND_API_BASE_URL from PORTAL_PUBLIC_SDK_BASE_URL + /backend/v3/api when no Commerce-specific override is configured.",
            "Claw Router admin runtime uses product-local contract fallback filtering so Commerce dependency backend routes return 404 by default instead of local 501 contract stubs.",
            "cargo test -p sdkwork-claw-admin --test contract_routes default_router_does_not_mount_commerce_backend_routes_locally verifies default admin runtime does not locally serve Commerce backend routes.",
            "No Claw Router runtime mount coverage is declared for Commerce backend API handlers."
          ]
        }
      }
    }
  ]
}
