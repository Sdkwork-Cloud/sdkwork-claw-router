{
  "schemaVersion": 1,
  "kind": "sdkwork.dependency-api-surfaces",
  "application": "sdkwork-clawrouter",
  "description": "Runtime dependency API surface declarations for dependency SDKs consumed by SDKWork Claw Router. sdkDependencies owns generation boundaries; this manifest owns runtime mount/base-url decisions.",
  "gatewayIntegration": {
    "targetApplication": "sdkwork-api-gateway",
    "targetMode": "shared-gateway",
    "commonSdkRootEnv": "PORTAL_PUBLIC_SDK_BASE_URL",
    "authority": "cargo-workspace",
    "catalogPolicy": "no-dedicated-gateway-catalog",
    "productApiPolicy": "sdkwork-clawrouter APIs remain product-owned SDKWork API surfaces",
    "migrationState": "shared-gateway-default"
  },
