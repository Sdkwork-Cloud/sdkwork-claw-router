{
  "name": "@sdkwork/file-upload-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SDKWork standard presigned upload client for single-part and multipart file uploads.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "node ../../../../sdkwork-appbase/node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ../../../../sdkwork-appbase/node_modules/vitest/vitest.mjs run tests --pool vmThreads"
  },
  "dependencies": {
    "@sdkwork/file-sdk-ports": "workspace:*"
  },
  "sdkwork": {
    "architecture": "common",
    "capability": "file-upload-client",
    "domain": "file",
    "packageType": "domain-package",
    "status": "standard"
