# Claw Router topology profile: cloud-hosted + split-services + production

SDKWORK_CLAW_ROUTER_HOSTING=cloud-hosted
SDKWORK_CLAW_ROUTER_SERVICE_LAYOUT=split-services
SDKWORK_CLAW_ROUTER_ENVIRONMENT=production
SDKWORK_CLAW_ROUTER_PROFILE_ID=cloud-hosted.split-services.production

SDKWORK_CLAW_ROUTER_APPLICATION_PUBLIC_HTTP_URL=https://clawrouter.sdkwork.com
SDKWORK_CLAW_ROUTER_APPLICATION_BACKEND_HTTP_URL=https://clawrouter-admin.sdkwork.com
SDKWORK_CLAW_ROUTER_APPLICATION_OPEN_HTTP_URL=https://clawrouter.sdkwork.com

SDKWORK_API_GATEWAY_CONFIG=configs/sdkwork-api-gateway.claw-router.production.toml
SDKWORK_CLAW_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_CLAW_ROUTER_PLATFORM_API_GATEWAY_AUTOSTART=false

VITE_SDKWORK_CLAW_ROUTER_HOSTING=cloud-hosted
VITE_SDKWORK_CLAW_ROUTER_APPLICATION_PUBLIC_HTTP_URL=https://clawrouter.sdkwork.com
VITE_SDKWORK_CLAW_ROUTER_APPLICATION_BACKEND_HTTP_URL=https://clawrouter-admin.sdkwork.com
VITE_SDKWORK_CLAW_ROUTER_APPLICATION_OPEN_HTTP_URL=https://clawrouter.sdkwork.com
VITE_SDKWORK_CLAW_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_APPBASE_APP_API_BASE_URL=https://api.sdkwork.com/app/v3/api
VITE_SDKWORK_IAM_APP_API_BASE_URL=https://api.sdkwork.com
