# Claw Router topology profile: cloud-hosted + unified-process + development

SDKWORK_CLAW_ROUTER_HOSTING=cloud-hosted
SDKWORK_CLAW_ROUTER_SERVICE_LAYOUT=unified-process
SDKWORK_CLAW_ROUTER_ENVIRONMENT=development
SDKWORK_CLAW_ROUTER_PROFILE_ID=cloud-hosted.unified-process.development

SDKWORK_CLAW_ROUTER_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:3900
SDKWORK_CLAW_ROUTER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CLAW_ROUTER_APPLICATION_BACKEND_HTTP_BIND=0.0.0.0:3900
SDKWORK_CLAW_ROUTER_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CLAW_ROUTER_APPLICATION_OPEN_HTTP_BIND=0.0.0.0:3900
SDKWORK_CLAW_ROUTER_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CLAW_ROUTER_INTERNAL_PORTAL_RENDERER_BIND=127.0.0.1:3901

SDKWORK_API_GATEWAY_BIND=127.0.0.1:3902
SDKWORK_API_GATEWAY_CONFIG=configs/sdkwork-api-gateway.claw-router.development.toml
SDKWORK_CLAW_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3902
SDKWORK_CLAW_ROUTER_PLATFORM_API_GATEWAY_AUTOSTART=true

VITE_SDKWORK_CLAW_ROUTER_HOSTING=cloud-hosted
VITE_SDKWORK_CLAW_ROUTER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:3900
VITE_SDKWORK_CLAW_ROUTER_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:3900
VITE_SDKWORK_CLAW_ROUTER_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:3900
VITE_SDKWORK_CLAW_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3902
VITE_SDKWORK_APPBASE_APP_API_BASE_URL=http://127.0.0.1:3902/app/v3/api
VITE_SDKWORK_IAM_APP_API_BASE_URL=http://127.0.0.1:3902
