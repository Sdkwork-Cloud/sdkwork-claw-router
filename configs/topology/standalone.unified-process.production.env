# standalone.unified-process.production
# Appliance/private-server profile: bind loopback only; terminate TLS at reverse proxy or ingress.
SDKWORK_CLAW_ROUTER_DEPLOYMENT_PROFILE=standalone
SDKWORK_CLAW_ROUTER_SERVICE_LAYOUT=unified-process
SDKWORK_CLAW_ROUTER_ENVIRONMENT=production
SDKWORK_CLAW_ROUTER_PROFILE_ID=standalone.unified-process.production

# Controlled schema migrations only; never auto-install at gateway startup in production.
SDKWORK_CLAW_STARTUP_INSTALL_MODE=skip

SDKWORK_CLAW_ROUTER_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900
SDKWORK_CLAW_ROUTER_APPLICATION_PUBLIC_HTTP_URL=https://127.0.0.1:3900
SDKWORK_CLAW_ROUTER_APPLICATION_BACKEND_HTTP_BIND=127.0.0.1:3900
SDKWORK_CLAW_ROUTER_APPLICATION_BACKEND_HTTP_URL=https://127.0.0.1:3900
SDKWORK_CLAW_ROUTER_APPLICATION_OPEN_HTTP_BIND=127.0.0.1:3900
SDKWORK_CLAW_ROUTER_APPLICATION_OPEN_HTTP_URL=https://127.0.0.1:3900

SDKWORK_API_CLOUD_GATEWAY_BIND=127.0.0.1:3902
SDKWORK_CLAW_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=https://127.0.0.1:3902
SDKWORK_CLAW_ROUTER_PLATFORM_API_GATEWAY_AUTOSTART=false

VITE_SDKWORK_CLAW_ROUTER_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_CLAW_ROUTER_APPLICATION_PUBLIC_HTTP_URL=https://127.0.0.1:3900
VITE_SDKWORK_CLAW_ROUTER_APPLICATION_BACKEND_HTTP_URL=https://127.0.0.1:3900
VITE_SDKWORK_CLAW_ROUTER_APPLICATION_OPEN_HTTP_URL=https://127.0.0.1:3900
VITE_SDKWORK_CLAW_ROUTER_PLATFORM_API_GATEWAY_HTTP_URL=https://127.0.0.1:3902
